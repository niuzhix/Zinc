<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:Zinc.Controls"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="40"
             x:Class="Zinc.Controls.IconText"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" Spacing="{Binding Spacing, ElementName=Root}">
        <controls:FAFontIcon Glyph="{Binding Glyph, ElementName=Root}"
                             VerticalAlignment="Center"
                             FontSize="16"
                             FontFamily="{StaticResource FluentIcons}"/>
        <TextBlock Text="{Binding Text, ElementName=Root}"
                   VerticalAlignment="Center"
                   LineSpacing="0"
                   Margin="0 0 0 -4"
                   x:Name="TextElement"
                   IsVisible="{Binding Glyph, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>