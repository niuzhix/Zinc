<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Zinc.App"
             xmlns:sty="using:FluentAvalonia.Styling">

	<Application.Resources>
		<FontFamily x:Key="HarmonyOsSans">
			avares://Zinc/Assets/Fonts/#HarmonyOS Sans SC
		</FontFamily>
		<FontFamily x:Key="FluentIcons">
			avares://Zinc/Assets/Fonts/#FluentSystemIcons-Resizable
		</FontFamily>
		<SolidColorBrush x:Key="ACBrush" Color="#00CC00"/>
		<SolidColorBrush x:Key="WABrush" Color="#FF0000"/>
		<SolidColorBrush x:Key="TLEBrush" Color="#FFA500"/>
		<SolidColorBrush x:Key="MLEBrush" Color="#9370DB"/>
		<SolidColorBrush x:Key="REBrush" Color="#FF00FF"/>
		<SolidColorBrush x:Key="CEBrush" Color="#0000FF"/>
		<SolidColorBrush x:Key="UKEBrush" Color="#808080"/>
	</Application.Resources>

	<Application.Styles>
		<sty:FluentAvaloniaTheme/>
		<Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="{StaticResource HarmonyOsSans}" />
        </Style>
		<Style Selector=":is(ScrollViewer)">
            <Setter Property="MaxWidth" Value="1200"/>
        </Style>
		<Style Selector=":is(ToggleSwitch)">
			<Setter Property="OnContent" Value="开"/>
			<Setter Property="OffContent" Value="关"/>
		</Style>
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
	</Application.Styles>
</Application>
