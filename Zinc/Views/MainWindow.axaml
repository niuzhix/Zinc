<Window xmlns="https://github.com/avaloniaui"
		xmlns:controls="using:FluentAvalonia.UI.Controls"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Zinc.ViewModels"
		xmlns:views="using:Zinc.Views"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Zinc.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/Zinc.ico"
		Title="Zinc"
		Opacity="{Binding Settings.Opacity}">

	<!-- 预览器的绑定类型由 x:DataType 提供；运行时 DataContext 由构造函数从 App.Services 取得。 -->

	<views:MainView DataContext="{Binding MainViewModel}"/>
</Window>
