<Window xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:FluentAvalonia.UI.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Zinc.Views.SettingsWindow"
        Title="Zinc Settings">
    <controls:FANavigationView HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               PaneDisplayMode="Auto"
                               IsBackButtonVisible="True"
                               IsSettingsVisible="False"
                               SelectionChanged="FANavigationView_SelectionChanged">
        <controls:FANavigationView.MenuItems>
            <controls:FANavigationViewItem Content="A" Tag="Basic" IconSource="Play"/>
        </controls:FANavigationView.MenuItems>
    </controls:FANavigationView>
</Window>
