<Window xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:FluentAvalonia.UI.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="using:Zinc.Views.SettingsPages"
        xmlns:vm="using:Zinc.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="560"
        Icon="/Assets/Zinc.ico"
        Title="应用设置" Height="550" Width="1240"
        x:Class="Zinc.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:SPUIViewModel">
            <pages:SPUIView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SPEditViewModel">
            <pages:SPEditView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SPCompileViewModel">
            <pages:SPCompileView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SPAboutViewModel">
            <pages:SPAboutView/>
        </DataTemplate>
    </Window.DataTemplates>

    <controls:FANavigationView HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               PaneDisplayMode="Auto"
                               IsBackButtonVisible="False"
                               IsSettingsVisible="False"
                               OpenPaneLength="283"
                               MenuItemsSource="{Binding MenuPages}"
                               FooterMenuItemsSource="{Binding FooterPages}"
                               SelectedItem="{Binding SelectedPage}"
                               SelectionChanged="FANavigationView_SelectionChanged">
        <controls:FANavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="vm:SettingsPageItem">
                <controls:FANavigationViewItem Content="{Binding Title}" Tag="{Binding}">
                    <controls:FANavigationViewItem.IconSource>
                        <controls:FAFontIconSource Glyph="{Binding Glyph}"
                                                   FontFamily="{StaticResource FluentIcons}"/>
                    </controls:FANavigationViewItem.IconSource>
                </controls:FANavigationViewItem>
            </DataTemplate>
        </controls:FANavigationView.MenuItemTemplate>
        <controls:FANavigationView.Content>
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </controls:FANavigationView.Content>
    </controls:FANavigationView>
</Window>
